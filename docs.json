{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "UgameDeal",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 650
    },
    "body": {
      "family": "Inter"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0B1220"
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "css": "/style.css",
  "js": [
    "/sidebar-active.js"
  ],
  "navigation": {
    "languages": [
      {
        "language": "zh-CN",
        "default": true,
        "pages": [
          {
            "group": "快速开始",
            "pages": [
              "index",
              "config"
            ]
          },
          {
            "group": "代收接口",
            "pages": [
              "payin/api",
              "payin/async-callback",
              "payin/order-query",
              "payin/refund",
              "payin/dispute"
            ]
          },
          {
            "group": "代收支付方式",
            "pages": [
              "payin/methods/global",
              "payin/methods/asia",
              "payin/methods/europe",
              "payin/methods/north-america",
              "payin/methods/south-america",
              "payin/methods/middle-east",
              "payin/methods/russia"
            ]
          },
          {
            "group": "产品介绍",
            "pages": [
              "payin/intro"
            ]
          }
        ]
      },
      {
        "language": "en",
        "pages": [
          {
            "group": "Getting started",
            "pages": [
              "en/index",
              "en/config"
            ]
          },
          {
            "group": "Pay-in APIs",
            "pages": [
              "en/payin/api",
              "en/payin/async-callback",
              "en/payin/order-query",
              "en/payin/refund",
              "en/payin/dispute"
            ]
          },
          {
            "group": "Pay-in methods",
            "pages": [
              "en/payin/methods/global",
              "en/payin/methods/asia",
              "en/payin/methods/europe",
              "en/payin/methods/north-america",
              "en/payin/methods/south-america",
              "en/payin/methods/middle-east",
              "en/payin/methods/russia"
            ]
          },
          {
            "group": "Product",
            "pages": [
              "en/payin/intro"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "logo": {
    "light": "/logo/ugamedeal-logo.png",
    "dark": "/logo/ugamedeal-logo.png",
    "href": "/"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/",
      "github": "https://github.com/"
    }
  }
}
